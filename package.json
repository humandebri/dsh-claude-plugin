{
  "name": "dsh-claude-plugin",
  "version": "0.1.0",
  "description": "Use Claude Code as a primary DeepSeek Harness model route",
  "license": "MIT",
  "author": "snowan",
  "type": "module",
  "bin": {
    "dsh-claude-plugin": "./lib/cli.js"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "AUTHORS.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "npm@11.7.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowan/dsh-claude-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/snowan/dsh-claude-plugin/issues"
  },
  "homepage": "https://github.com/snowan/dsh-claude-plugin#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run publint && npm run pack:check && npm run check:authorship && npm run check:docs",
    "check:authorship": "node scripts/check-authorship.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "format": "prettier --write src tests scripts/*.mjs *.json *.yml *.ts .github/workflows/*.yml",
    "format:check": "prettier --check src tests scripts/*.mjs *.json *.yml *.ts .github/workflows/*.yml",
    "lint": "oxlint --deny-warnings src tests scripts vitest.config.ts",
    "pack:check": "node scripts/check-pack.mjs",
    "prepare": "npm run build",
    "publint": "node scripts/run-publint.mjs",
    "smoke:claude": "npm run build && node scripts/smoke-claude.mjs",
    "test": "vitest run",
    "test:profile": "npm run build && node scripts/profile-install-e2e.mjs",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.2 <0.2.0",
    "@deepseek-ai/dsh-subprocess": ">=0.1.1-rc.2 <0.2.0"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.241",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-attachment": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subprocess-local": "0.1.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.1.1-rc.2",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.8",
    "oxlint": "1.76.0",
    "pnpm": "10.34.5",
    "prettier": "3.9.6",
    "publint": "0.3.24",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
